{
  "name": "rotinae-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/agendae run start",
    "web": "npm --prefix apps/agendae run web",
    "android": "npm --prefix apps/agendae run android",
    "ios": "npm --prefix apps/agendae run ios",
    "lint": "npm --prefix apps/agendae run lint",
    "typecheck": "npm --prefix apps/agendae run typecheck",
    "test:emails": "node --test emails/*.test.mjs",
    "preview:emails": "node emails/generate-previews.mjs",
    "export:web": "npm --prefix apps/agendae run export:web",
    "preview:web": "node scripts/serve-static.mjs",
    "check": "npm run lint && npm run typecheck && npm run export:web"
  }
}
